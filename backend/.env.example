# ---------------------------------------------------------------------------
# Environment variables for the backend/ Supabase tooling (setup-*.cjs and
# verify-*.cjs scripts). Copy this file to `backend/.env` and fill in real
# values. NEVER commit real values — only this template.
#
#   cp backend/.env.example backend/.env
#
# The scripts load backend/.env automatically via dotenv; values already
# exported in your shell take precedence.
# ---------------------------------------------------------------------------

# Supabase publishable/anon key (safe to expose). Used by the verify-*.cjs
# scripts to connect to the Supabase project.
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Super-admin test account used by the verify-*.cjs scripts.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me

# Management API personal access token (starts with sbp_). Required by the
# setup-*.cjs scripts; optionally used by verify-*.cjs to seed/clean up test
# accounts and inspect schema. Treat as a secret: never commit a real value.
SUPABASE_MANAGEMENT_TOKEN=sbp_your_access_token