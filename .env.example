# ---------------------------------------------------------------------------
# Environment variables for the Retrofit Portal.
# Copy this file to `.env.local` (or the environment file of your choice) and
# fill in real values. NEVER commit real values — only this template.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase project URL (from Project Settings -> API).
# Used by src/lib/supabaseClient.js.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon key (safe to expose in the browser bundle).
# Used by src/lib/supabaseClient.js.
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# Super-admin test account used by scripts/verify-*.cjs (optional overrides —
# the scripts fall back to a provisioned test account when these are unset).
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me

# Management API personal access token (starts with sbp_). Optional — used by
# verify-invite-staff.cjs / verify-taskboard.cjs only to clean up the test
# accounts/tasks they create. Treat as a secret: never commit a real value.
SUPABASE_MANAGEMENT_TOKEN=sbp_your_access_token

# Vercel CLI OIDC token (written automatically by `vercel login`/deploy). This
# is managed by the Vercel CLI, not read by the app; no need to set it manually.
VERCEL_OIDC_TOKEN=